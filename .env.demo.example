# =============================================================
# DB-GPT DEMO - ORNEK ORTAM DEGISKENLERI
# =============================================================
# KULLANIM:
#   1) Bu dosyayi ".env.demo" adiyla kopyala.
#   2) Asagidaki degerleri kendi bilgilerinle doldur.
#   3) Anahtarlari ortama yukle (bkz. README.demo.tr.md).
#
# NOT: Gercek API anahtarlarini ASLA git'e gonderme.
#      ".env.demo" dosyasi .gitignore'da olmali.
# =============================================================

# ---- Arayuz dili: tr / en / zh ----
DBGPT_LANG=tr

# ---- Metadata sifreleme anahtari (rastgele bir deger gir) ----
DBGPT_ENCRYPT_KEY=demo_secret_key_degistir

# =============================================================
# LLM SAGLAYICI - VARSAYILAN: Google Gemini (ucretsiz)
# Ucretsiz anahtar: https://aistudio.google.com/apikey
# Tek anahtar hem LLM hem embedding icin kullanilir.
# =============================================================
GEMINI_API_KEY=buraya-gemini-anahtarini-yaz
# Asagidakiler varsayilan; degistirmen gerekmez
LLM_MODEL_NAME=gemini-2.5-flash
EMBEDDING_MODEL_NAME=gemini-embedding-001

# ---- Alternatif: OpenAI ----
# OPENAI_API_KEY=sk-...

# ---- Alternatif: SiliconFlow ----
# SILICONFLOW_API_KEY=

# ---- Alternatif: DeepSeek ----
# DEEPSEEK_API_KEY=

# =============================================================
# DEMO POSTGRESQL VERITABANI (analiz edilen veri kaynagi)
# Bu degerler docker-compose.demo.yml ile birebir ayni olmali.
# DB-GPT arayuzunden "Data Source" eklerken bu bilgileri kullan.
# =============================================================
DEMO_PG_HOST=127.0.0.1
DEMO_PG_PORT=5432
DEMO_PG_DATABASE=demo_ai_database
DEMO_PG_USER=demo_user
DEMO_PG_PASSWORD=demo_pass_123
